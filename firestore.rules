rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // --- Items Collection ---
    match /items/{itemId} {
      // Anyone can see listed items.
      allow read: if true;
      // Authenticated users can create items for themselves.
      allow create: if isAuthenticated() && isOwner(request.resource.data.sellerId);
      // Only the item owner can update or delete it.
      allow update, delete: if isAuthenticated() && isOwner(resource.data.sellerId);

      // Subcollections for items (e.g., views)
      match /views/{viewId} {
        // Any authenticated user can create a view record.
        allow create: if isAuthenticated();
      }
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Anyone can view a user's public profile.
      allow read: if true;

      // A user can only create their own profile document.
      allow create: if isOwner(userId);

      // Complex update rule for user profiles
      allow update: if isAuthenticated() &&
      (
        // Rule 1: A user is updating their own profile's general info.
        ( isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'location', 'avatarUrl', 'dataAiHint', 'lastActiveAt'])
        ) ||
        // Rule 2: A user is updating their OWN subscriptionCount when they subscribe/unsubscribe.
        ( isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriptionCount']) &&
          (request.resource.data.subscriptionCount == resource.data.subscriptionCount + 1 ||
           request.resource.data.subscriptionCount == resource.data.subscriptionCount - 1)
        ) ||
        // Rule 3: ANOTHER user is updating THIS user's subscriberCount when they subscribe/unsubscribe.
        ( !isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberCount']) &&
          (request.resource.data.subscriberCount == resource.data.subscriberCount + 1 ||
           request.resource.data.subscriberCount == resource.data.subscriberCount - 1)
        ) ||
        // Rule 4: A user is spending credits or a free listing.
        ( isOwner(userId) &&
           (
              (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits']) &&
                request.resource.data.credits == resource.data.credits - 1
              ) || (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['freeListingsRemaining']) &&
                request.resource.data.freeListingsRemaining == resource.data.freeListingsRemaining - 1
              )
           )
        )
      );
                       
      // Subscriptions: A user can manage their own list of who they subscribe to.
      match /subscriptions/{targetUserId} {
        allow read, create, delete: if isOwner(userId);
      }
      
      // Subscribers: A user can add/remove themselves to/from another user's list.
      match /subscribers/{subscriberId} {
        allow read: if isAuthenticated();
        allow create, delete: if isOwner(subscriberId);
      }
      
      // Notifications: A user can read/delete their own. They are created by the server.
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if false; 
      }

      // View History: A user can only manage their own view history.
      match /viewHistory/{historyId} {
        allow write, read: if isOwner(userId);
      }
    }
    
    // --- Reviews Collection ---
    match /reviews/{reviewId} {
      // Anyone can read reviews.
      allow read: if true;
      // Only an authenticated user can create a review for themselves.
      // Further logic (can't review own item) is in server-side code.
      allow create: if isAuthenticated() && isOwner(request.resource.data.reviewerId);
    }
    
    // --- Reports Collection ---
    match /productReports/{itemId}/reports/{userId} {
      // Users cannot read reports.
      allow read: if false;
      // Only an authenticated user can create a report as themselves.
      allow create: if isAuthenticated() && isOwner(userId);
    }
    
    // --- Favorites Collections ---
    match /collections/{collectionId} {
      // A user can read, create, update, and delete their own collections.
      allow read, create, update, delete: if isOwner(resource.data.userId);

      // Items subcollection within a user's collection.
      match /items/{itemId} {
        allow read: if isOwner(get(/databases/$(database)/documents/collections/$(collectionId)).data.userId);
        allow create, delete: if isOwner(get(/databases/$(database)/documents/collections/$(collectionId)).data.userId);
      }
    }

    // --- Message Threads Collection ---
    match /messageThreads/{threadId} {
      // Participants can read/update the thread document metadata.
      allow read, update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      // Threads are created via a server-side API route, not directly by clients.
      allow create: if false;

      // Messages sub-collection within a thread.
      match /messages/{messageId} {
        // Participants can read messages in the thread.
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
        // A user can only create a message if they are a participant and the sender.
        allow create: if isAuthenticated() &&
                         request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds &&
                         isOwner(request.resource.data.senderId);
      }
    }
    
    // --- Payment Intents Collection ---
    // This collection is only accessible by the server using Admin SDK, so deny all client access.
    match /paymentIntents/{intentId} {
      allow read, write: if false;
    }
    
    // --- Rate Limiting Collection ---
    // This collection is only accessible by the server using Admin SDK.
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }
  }
}
