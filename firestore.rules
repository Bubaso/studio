rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================
    // Helper Functions
    // =================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // =================================
    // Users Collection
    // =================================
    match /users/{userId} {
      // Anyone can view a user's public profile
      allow get: if true;
      
      // Only the owner can create or update their own profile document.
      // `create` is needed for first-time sign-up.
      // `update` is for profile edits.
      allow create, update: if isOwner(userId);
      
      // Users can only be deleted via a secure backend function.
      allow delete: if false;

      // --- User Subcollections ---
      match /viewHistory/{historyId} {
        allow read, write: if isOwner(userId);
      }
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
      match /subscriptions/{subscriptionId} {
         allow read: if true;
         allow write: if isOwner(userId);
      }
      match /subscribers/{subscriberId} {
         allow read: if true;
         allow write: if isOwner(userId) || isOwner(subscriberId);
      }
      match /statuses/{statusId} {
         allow read: if true;
         allow create, delete: if isOwner(userId);
         allow update: if false; // Statuses are immutable
      }
    }
    
    // =================================
    // Items Collection
    // =================================
    match /items/{itemId} {
      // Anyone can view an item listing
      allow get, list: if true;
      
      // Only signed-in users can create items.
      // Further checks (e.g., credits) are done in backend/transactions.
      allow create: if isSignedIn();
      
      // Only the seller can update or delete their own item.
      allow update, delete: if isOwner(resource.data.sellerId);

      // --- Item Subcollections ---
      match /views/{viewId} {
        // A user can log a view if they are signed in and not the seller.
        allow create: if isSignedIn() && request.auth.uid != get(/databases/$(database)/documents/items/$(itemId)).data.sellerId;
        
        // Anyone should be able to count the views.
        // `list` is needed for `getDocs` to work on the client.
        allow list: if true;
        
        // No one should be able to read individual view documents to protect privacy.
        allow get: if false; 
      }
    }
    
    // =================================
    // Message Threads Collection
    // =================================
    match /messageThreads/{threadId} {
      // Only participants can read or write to a thread.
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      
      match /messages/{messageId} {
        // Only participants can read or write messages within the thread.
        allow read, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
      }
    }

    // =================================
    // Product Reports Collection
    // =================================
    match /productReports/{itemId} {
        // Only signed-in users can create/read reports, but can only write their own.
        match /reports/{userId} {
            allow read, create: if isOwner(userId);
            allow update, delete: if false;
        }
    }

    // =================================
    // Reviews Collection
    // =================================
    match /reviews/{reviewId} {
        // Anyone can read reviews.
        allow get, list: if true;
        // Only signed-in users can create reviews.
        allow create: if isSignedIn();
        // Reviews are immutable once created.
        allow update, delete: if false; 
    }

    // =================================
    // Payment Intents Collection
    // =================================
    match /paymentIntents/{intentId} {
        // Only the user who created the intent can read it.
        // Only backend can write to it.
        allow read: if isOwner(resource.data.userId);
        allow write: if false;
    }

    // =================================
    // Collections (Favorites)
    // =================================
    match /collections/{collectionId} {
        allow get: if true; // Allow anyone to read collection info (e.g., if shared)
        allow create, update, delete: if isOwner(resource.data.userId);

        match /items/{itemId} {
            allow read, write: if isOwner(get(/databases/$(database)/documents/collections/$(collectionId)).data.userId);
        }
    }

    // =================================
    // Rate Limits Collection
    // =================================
    match /rateLimits/{docId} {
      // Only backend functions can access this.
      allow read, write: if false;
    }
  }
}
