rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner of a document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Items: Publicly readable, only owner can create/update/delete
    match /items/{itemId} {
      allow get: if true; // Everyone can view an item
      allow list: if true; // Everyone can browse/query items
      
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.sellerId == request.auth.uid;

      // Subcollection for views
      match /views/{viewId} {
        allow create: if isAuthenticated(); // Any logged-in user can add a view
        allow read, update, delete: if false; // No one should read/modify view logs directly
      }
    }
    
    // Users: Publicly readable profile, only owner can update
    match /users/{userId} {
      allow get: if true; // Everyone can view a user's profile
      
      // Allow create only if the user is creating their own document
      allow create: if isOwner(userId);
      
      // Allow update only by the owner
      allow update: if isOwner(userId);
      
      // No one can delete user docs from the client
      allow delete: if false;

      // Subcollections for user-specific data
      match /subscriptions/{targetId} {
        allow read, write: if isOwner(userId);
      }
      match /subscribers/{subscriberId} {
         allow read: if isAuthenticated(); // Allow reading who subscribes to a user
         allow write: if false; // Writes handled by server logic/transaction
      }
       match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
      match /viewHistory/{historyId} {
        allow read, write: if isOwner(userId);
      }
       match /statuses/{statusId} {
        allow create, delete: if isOwner(userId);
        allow read: if true; // Statuses are public
      }
    }
    
    // Message Threads: Only participants can access
    match /messageThreads/{threadId} {
      // User can read, update, or delete a thread if they are a participant
      allow read, update, delete: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      // User can create a thread if they are authenticated
      // Further checks (e.g., ensuring creator is a participant) done in create-thread API
      allow create: if isAuthenticated();
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read, create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
        allow update, delete: if false; // Prevent editing/deleting messages
      }
    }

    // Reviews: Publicly readable, only authenticated users can create
    match /reviews/{reviewId} {
      allow read: if true;
      allow list: if true;
      // User can create a review if they are authenticated and not the seller of the item
      allow create: if isAuthenticated() && request.resource.data.reviewerId == request.auth.uid && request.resource.data.sellerId != request.auth.uid;
      allow update, delete: if false;
    }
    
    // Product Reports: Only authenticated users can create reports
    match /productReports/{itemId} {
      // This allows access to the subcollection path
      allow get: if false;
      allow list, update, delete, create: if false;
      
      match /reports/{userId} {
        // A user can create their own report document
        allow create: if isOwner(userId);
        // Nobody can read/update/delete reports from the client
        allow read, update, delete: if false;
      }
    }

    // Payment Intents: Handled server-side, but client might need to read their own
    match /paymentIntents/{intentId} {
        allow create, update, delete: if false; // Server-only
        allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Collections: Users can manage their own
    match /collections/{collectionId} {
        allow read, create, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
        
        match /items/{itemId} {
           allow read, create, delete: if isAuthenticated() && get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == request.auth.uid;
           allow update: if false;
        }
    }
  }
}
