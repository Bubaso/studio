rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // --- Items Collection ---
    match /items/{itemId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth.uid == resource.data.sellerId;
      allow delete: if request.auth.uid == resource.data.sellerId;

      // Subcollection for views
      match /views/{viewId} {
        // Who can see the views? Only the seller for privacy.
        get: if get(/databases/$(database)/documents/items/$(itemId)).data.sellerId == request.auth.uid;
        // Who can list views (required for counting)? Any authenticated user.
        list: if request.auth != null;
        // Who can create a view? Any authenticated user who is NOT the seller.
        create: if request.auth != null && get(/databases/$(database)/documents/items/$(itemId)).data.sellerId != request.auth.uid;
        // No one can update or delete views directly.
        update, delete: if false;
      }
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Anyone can read a user's public profile
      allow read: if true;
      // Only the authenticated user can create their own document or update/delete it
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      
      // Subscriptions subcollection
      match /subscriptions/{targetUserId} {
          allow read: if true;
          allow create, delete: if request.auth != null && request.auth.uid == userId;
      }
      // Subscribers subcollection
      match /subscribers/{subscriberId} {
          allow read: if true;
          allow create, delete: if request.auth != null && request.auth.uid == subscriberId;
      }
      // View History subcollection
       match /viewHistory/{historyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Statuses subcollection
      match /statuses/{statusId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // --- Message Threads Collection ---
    match /messageThreads/{threadId} {
        // Participants can read/write to the thread document itself
        allow read, update: if request.auth.uid in resource.data.participantIds;
        allow create: if request.auth != null;
        allow delete: if false; // Deletion is handled logically via 'deletedFor' field

        // Messages subcollection
        match /messages/{messageId} {
            allow read, create: if request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
            allow update, delete: if false;
        }
    }
    
    // --- Product Reports Collection ---
    match /productReports/{itemId} {
      allow read, write: if request.auth != null;
      
      match /reports/{userId} {
         allow read, write: if request.auth != null;
      }
    }

     // --- Reviews Collection ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.reviewerId;
    }
    
    // --- Collections (Favorites) ---
    match /collections/{collectionId} {
        allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
        match /items/{itemId} {
             allow read, write: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/collections/$(collectionId)).data.userId;
        }
    }
    
    // --- Rate Limits (Server-side only) ---
    match /rateLimits/{docId} {
      allow read, write: if false; // Client should never access this
    }

    // --- Payment Intents ---
    match /paymentIntents/{intentId} {
      // Clients can read their own pending intents. IPN handler (server) updates them.
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Only server can write
    }
  }
}
