rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if only specific keys are being changed during an update.
    function areAllowedKeysUpdated(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    // Helper function to check if a specific key is being incremented/decremented by 1.
    function isIncrementedByOne(key) {
      // Ensure the keys exist before comparing to avoid errors
      return key in request.resource.data && key in resource.data &&
             (request.resource.data[key] == resource.data[key] + 1 ||
              request.resource.data[key] == resource.data[key] - 1);
    }

    match /users/{userId} {
      allow read;
      allow create: if request.auth.uid == userId;

      allow update: if 
        // Case 1: Updating your OWN profile for standard fields (name, location, etc.)
        (request.auth.uid == userId && areAllowedKeysUpdated(['name', 'avatarUrl', 'location', 'dataAiHint', 'lastActiveAt'])) ||
        // Case 2: Updating your OWN subscriptionCount when you subscribe/unsubscribe to someone.
        (request.auth.uid == userId && areAllowedKeysUpdated(['subscriptionCount']) && isIncrementedByOne('subscriptionCount')) ||
        // Case 3: SOMEONE ELSE subscribing/unsubscribing to you, updating YOUR subscriberCount.
        (request.auth.uid != userId && areAllowedKeysUpdated(['subscriberCount']) && isIncrementedByOne('subscriberCount'));

      match /subscriptions/{targetUserId} {
        allow write: if request.auth.uid == userId;
      }

      match /subscribers/{subscriberId} {
        allow write: if request.auth.uid == subscriberId;
      }

      match /notifications/{notificationId} {
        allow read, write: if request.auth.uid == userId;
      }

      match /viewHistory/{historyId} {
        allow write: if request.auth.uid == userId;
      }
    }

    match /items/{itemId} {
      allow read;
      allow create: if request.auth.uid == request.resource.data.sellerId;
      allow update: if request.auth.uid == resource.data.sellerId;
      allow delete: if request.auth.uid == resource.data.sellerId;

      match /views/{viewId} {
        allow create: if request.auth.uid != null;
      }
    }
    
    match /collections/{collectionId} {
        allow read;
        allow create: if request.auth.uid == request.resource.data.userId;
        allow update: if request.auth.uid == resource.data.userId;
        allow delete: if request.auth.uid == resource.data.userId;

        match /items/{itemId} {
            allow write: if get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == request.auth.uid;
        }
    }
    
    match /productReports/{itemId}/reports/{userId} {
        allow create: if request.auth.uid == userId;
    }
    
    match /reviews/{reviewId} {
        allow read;
        allow create: if request.auth.uid == request.resource.data.reviewerId;
    }
    
    match /messageThreads/{threadId} {
        allow read, update, create: if request.auth.uid in resource.data.participantIds;
        
        match /messages/{messageId} {
            allow read, create: if request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
        }
    }
    
    match /paymentIntents/{intentId} {
        allow read, create: if request.auth.uid == request.resource.data.userId;
    }
    
    match /rateLimits/{docId} {
      // This collection should only be written to by a trusted server process (Admin SDK)
      // which bypasses security rules. Denying client writes is a secure default.
      allow read: if false;
      allow write: if false;
    }
  }
}
