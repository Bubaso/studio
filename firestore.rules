rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection can be read by anyone, but only the user themselves can create/update/delete their own document.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Rules for user subcollections
      match /subscriptions/{subscriptionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /subscribers/{subscriberId} {
        allow read: if true;
        // Only the subscriber can add/remove themselves
        allow write: if request.auth != null && request.auth.uid == subscriberId;
      }
      match /notifications/{notificationId} {
      	allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /viewHistory/{historyId} {
      	allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /statuses/{statusId} {
        // Anyone can read statuses, but only the user can create/delete their own.
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Items can be read by anyone. Create/update/delete requires being the seller.
    match /items/{itemId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.sellerId;
      allow update: if request.auth != null && request.auth.uid == resource.data.sellerId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.sellerId;
      
      // Anyone authenticated can log a view.
      match /views/{viewId} {
      	allow create: if request.auth != null;
        allow read: if false; // No one needs to read the list of views
      }
    }
    
    // Authenticated users can write reports under their own ID.
    match /productReports/{itemId}/reports/{userId} {
        allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reviews can be read by anyone. Can only be created by an authenticated user.
    match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.reviewerId;
    }

    // Message threads can be read/written to only by participants.
    match /messageThreads/{threadId} {
      allow read, update, delete: if request.auth != null && request.auth.uid in resource.data.participantIds;
      // Creation is handled by a secure API route, so client-side rule can be strict.
      allow create: if false;

      // Messages subcollection
      match /messages/{messageId} {
        allow read, create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
      }
    }

    // Collections can be read by anyone, but only owner can manage.
    match /collections/{collectionId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == request.auth.uid;
      
      match /items/{itemId} {
      	 allow read: if true;
         // Write is allowed if user owns the collection.
         allow write: if request.auth != null && get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == request.auth.uid;
      }
    }

    // Rate limits can only be written to by authenticated users for their own document
    match /rateLimits/{docId} {
      allow read, write: if request.auth != null && docId.startsWith(request.auth.uid);
    }
    
    // Payment intents are private to the user who creates them
    match /paymentIntents/{intentId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      // Allow creation by authenticated users for themselves
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
