
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // HELPER FUNCTIONS
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Checks if the user is updating only their general profile fields.
    function isUpdatingOwnProfile() {
      return isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'location', 'avatarUrl', 'dataAiHint']);
    }

    // Checks if the user is decrementing their own listing counters by exactly 1.
    function isDecrementingListingCounter() {
      let hasDecrementedFree = request.resource.data.freeListingsRemaining == resource.data.freeListingsRemaining - 1;
      let hasDecrementedCredits = request.resource.data.credits == resource.data.credits - 1;
      let onlyCounterChanged = request.resource.data.diff(resource.data).affectedKeys().hasOnly(['freeListingsRemaining']) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits']);

      return isOwner(userId) && onlyCounterChanged && (hasDecrementedFree || hasDecrementedCredits);
    }

    // Checks if the user is updating their own subscription count by exactly 1.
    function isUpdatingOwnSubscriptionCount() {
      return isOwner(userId) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriptionCount']) &&
             (request.resource.data.subscriptionCount == resource.data.subscriptionCount + 1 || request.resource.data.subscriptionCount == resource.data.subscriptionCount - 1);
    }

    // Checks if THIS user's subscriber count is being updated by exactly 1 by someone else.
    function isBeingSubscribedTo() {
      return !isOwner(userId) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberCount']) &&
             (request.resource.data.subscriberCount == resource.data.subscriberCount + 1 || request.resource.data.subscriberCount == resource.data.subscriberCount - 1);
    }
    
    // MAIN RULES

    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);

      // A user can be updated under very specific conditions.
      allow update: if isSignedIn() && (
        isUpdatingOwnProfile() ||
        isDecrementingListingCounter() ||
        isUpdatingOwnSubscriptionCount() ||
        isBeingSubscribedTo()
      );

      // Subcollections for a user
      match /subscriptions/{targetId} {
        allow read, create, delete: if isSignedIn() && isOwner(userId);
      }
      match /subscribers/{subscriberId} {
        // Only the subscriber can create/delete their entry in someone else's list.
        allow read: if isSignedIn() && isOwner(userId);
        allow create, delete: if isSignedIn() && isOwner(subscriberId);
      }
      match /viewHistory/{historyId} {
        allow read, create: if isSignedIn() && isOwner(userId);
      }
       match /notifications/{notificationId} {
        allow read, create, update: if isSignedIn() && isOwner(userId);
      }
    }

    match /items/{itemId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isOwner(resource.data.sellerId);
      allow delete: if isSignedIn() && isOwner(resource.data.sellerId);

      match /views/{viewId} {
        allow create: if isSignedIn();
      }
    }

    match /messageThreads/{threadId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn(); // Creation is handled by API route

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
        allow create: if isSignedIn(); // Creation is handled by API route
        allow update: if isSignedIn(); // For marking as read
      }
    }
    
    match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && isOwner(request.resource.data.reviewerId);
    }

    match /collections/{collectionId} {
      allow read, create, update, delete: if isSignedIn() && isOwner(resource.data.userId);

      match /items/{itemId} {
          allow read, create, delete: if isSignedIn() && isOwner(get(/databases/$(database)/documents/collections/$(collectionId)).data.userId);
      }
    }
    
    match /productReports/{itemId} {
       // Anyone can create a report document for an item
       allow create: if isSignedIn();
       
       match /reports/{userId} {
         // The user can create their own report, but cannot read/update/delete any.
         allow create: if isSignedIn() && isOwner(userId);
         allow read, update, delete: if false;
       }
    }
    
    match /counters/{counterId} {
      // The userCounter can only be updated via transactions in the backend. No direct client access.
      allow read, write: if false;
    }
    
    match /paymentIntents/{intentId} {
        allow read, create: if isSignedIn() && isOwner(resource.data.userId);
        allow update: if false; // Only backend can update via IPN
    }
  }
}
