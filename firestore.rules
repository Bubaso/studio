rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Counters for app-wide stats ---
    match /_counters/{counterId} {
      // Allow authenticated users to perform the transaction for creating a user account.
      // This is a trade-off for simplicity. For higher security, this should be a backend-only operation.
      allow read, write: if request.auth != null;
    }

    // --- Items: Publicly readable, only owners can write ---
    match /items/{itemId} {
      allow read: if true;
      allow create: if request.auth.uid == request.resource.data.sellerId;
      allow update: if request.auth.uid == resource.data.sellerId;
      allow delete: if request.auth.uid == resource.data.sellerId;

      // --- Subcollection for Views ---
      match /views/{viewId} {
        allow create: if request.auth != null;
        allow read, list: if true; // Anyone can read/list view counts
      }
    }

    // --- Users: Publicly readable, only owners can write ---
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      allow delete: if request.auth.uid == userId;
      
      // --- User Subcollections ---
      match /viewHistory/{historyId} {
        allow read, write: if request.auth.uid == userId;
      }
      match /subscriptions/{subscriptionId} {
        allow read, write: if request.auth.uid == userId;
      }
      match /subscribers/{subscriberId} {
        allow read, write: if request.auth != null; // Allow checking/listing subscribers
      }
      match /notifications/{notificationId} {
        allow read, write: if request.auth.uid == userId;
      }
      match /statuses/{statusId} {
          allow read: if true;
          allow create, update, delete: if request.auth.uid == userId;
      }
    }
    
    // --- Message Threads: Only participants can access ---
    match /messageThreads/{threadId} {
      // Participants can read/write thread document
      allow read, write: if request.auth.uid in resource.data.participantIds;

      // --- Messages Subcollection ---
      match /messages/{messageId} {
        // Participants can read/write messages
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
      }
    }
    
    // --- Product Reports ---
    match /productReports/{itemId} {
        match /reports/{userId} {
            allow create: if request.auth.uid == userId;
            allow read: if request.auth != null; // Allow checking if user has reported
        }
    }

    // --- Reviews ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth.uid == request.resource.data.reviewerId;
      allow update, delete: if false; // Reviews are immutable
    }

    // --- Collections ---
    match /collections/{collectionId} {
      allow read: if true; // Collections can be public if needed
      allow create, update, delete: if request.auth.uid == request.resource.data.userId;

      match /items/{itemId} {
        allow read: if true;
        allow write: if request.auth.uid == get(/databases/$(database)/documents/collections/$(collectionId)).data.userId;
      }
    }
  }
}
