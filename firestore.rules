rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // This function securely checks if the only change being made to a user document
    // is an increment or decrement of the subscriberCount by exactly 1.
    function isUpdatingSubscriberCount() {
      // Is the user authenticated?
      return request.auth != null &&
        // Are we only changing existing fields, not adding or removing any?
        request.resource.data.keys().hasAll(resource.data.keys()) &&
        resource.data.keys().hasAll(request.resource.data.keys()) &&
        // Is 'subscriberCount' the ONLY field being modified?
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberCount']) &&
        // Is the modification an increment or decrement of exactly 1?
        (
          request.resource.data.subscriberCount == resource.data.subscriberCount + 1 ||
          request.resource.data.subscriberCount == resource.data.subscriberCount - 1
        );
    }

    // USERS collection
    match /users/{userId} {
      // Anyone can read a user's public profile
      allow read: if true;
      // Only the owner can create their own profile
      allow create: if isOwner(userId);
      // The owner can update their profile, OR another authenticated user can update the subscriber count.
      allow update: if isOwner(userId) || isUpdatingSubscriberCount();
      // Users cannot delete their profiles through the client
      allow delete: if false;
      
      // USER subcollections
      match /subscriptions/{targetId} {
        // A user can only manage their own list of subscriptions.
        allow read, write: if isOwner(userId);
      }
      
      match /subscribers/{subscriberId} {
        // A user can only add/remove THEMSELVES to another user's subscribers list.
        allow write: if isOwner(subscriberId);
        // Only the profile owner can read who their subscribers are.
        allow read: if isOwner(userId);
      }
      
      match /notifications/{notificationId} {
        // A user can only read and update (e.g., mark as read) their own notifications.
        allow read, update: if isOwner(userId);
        // Notifications are created server-side, so no client create/delete.
        allow create, delete: if false;
      }
      
      match /viewHistory/{historyId} {
        // View history is written by the server/client but only for the logged-in user.
        allow create: if isOwner(userId);
        // Nobody can read/update/delete history directly from the client.
        allow read, update, delete: if false;
      }
    }

    // ITEMS collection
    match /items/{itemId} {
      // Anyone can read item listings
      allow read: if true;
      // Only the authenticated owner can create, update, or delete their own items
      allow create, update, delete: if isOwner(resource.data.sellerId);
      
      // ITEM SUBCOLLECTIONS (Views)
      match /views/{viewId} {
          // Only authenticated users can log a view.
          allow create: if request.auth != null;
          // Nobody can read/update/delete individual views.
          allow read, update, delete: if false;
      }
    }
    
    // This collection stores reports about items (e.g., reported as sold).
    match /productReports/{itemId}/reports/{userId} {
        // An authenticated user can report an item, but can't report their own item.
        allow create: if request.auth != null && request.auth.uid == userId && get(/databases/$(database)/documents/items/$(itemId)).data.sellerId != userId;
        // Nobody can read, update, or delete reports from the client.
        allow read, update, delete: if false;
    }

    // REVIEWS collection
    match /reviews/{reviewId} {
        // Anyone can read reviews
        allow read: if true;
        // Only authenticated users can create a review, and they can't review their own item
        allow create: if request.auth != null && request.resource.data.reviewerId == request.auth.uid && request.resource.data.sellerId != request.auth.uid;
        // Reviews are immutable from the client.
        allow update, delete: if false;
    }
    
    // MESSAGE THREADS collection
    match /messageThreads/{threadId} {
        // Participants can read, create, and update the thread document
        allow read, create, update: if request.auth != null && request.auth.uid in resource.data.participantIds;
        // Participants cannot delete the thread document itself
        allow delete: if false;
        
        // MESSAGES subcollection
        match /messages/{messageId} {
            // Participants of the thread can read and create messages
            allow read, create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
            // Messages are immutable from the client.
            allow update, delete: if false;
        }
    }
    
    // PAYMENT INTENTS collection
    match /paymentIntents/{intentId} {
        // The user who created the intent can read it
        allow read: if isOwner(resource.data.userId);
        // Only the user can create it, but nobody can update it from the client
        allow create: if isOwner(request.resource.data.userId);
        allow update, delete: if false; // IPN updates this via Admin SDK
    }
    
    // FAVORITE COLLECTIONS
    match /collections/{collectionId} {
        // The owner can do anything with their collection document.
        allow read, write, delete: if isOwner(resource.data.userId);
        
        // Items within a collection
        match /items/{itemId} {
            // The owner of the collection can add/remove items.
            allow read, write, delete: if isOwner(get(/databases/$(database)/documents/collections/$(collectionId)).data.userId);
        }
    }
  }
}
