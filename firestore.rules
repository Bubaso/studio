rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read any profile, but can only update their own.
    // User documents are created server-side, not by clients.
    match /users/{userId} {
      allow read: if true;
      allow update: if request.auth.uid == userId;
      // Disallow client-side creation/deletion of user profiles
      allow create, delete: if false; 
    }

    // Rules for user subcollections (notifications, subscriptions, etc.)
    match /users/{userId}/{subcollection}/{docId} {
        // Only the owner of the user document can access its subcollections
        allow read, write, delete: if request.auth.uid == userId;
    }
    
    // Items can be read by anyone. Only the seller can create, update, or delete.
    match /items/{itemId} {
      allow read: if true;
      allow create: if request.auth.uid == request.resource.data.sellerId;
      allow update, delete: if request.auth.uid == resource.data.sellerId;
    }
    
    // Views subcollection on an item can be written to by any authenticated user.
    match /items/{itemId}/views/{viewId} {
        allow create: if request.auth.uid != null;
        allow read, update, delete: if false; // No one should read/modify views
    }

    // Rules for user-favorite collections.
    match /collections/{collectionId} {
      allow read: if request.auth.uid == resource.data.userId;
      // Allow a user to create a collection for themselves.
      allow create: if request.auth.uid != null && request.auth.uid == request.resource.data.userId;
      // Allow a user to update/delete their own collection.
      allow update, delete: if request.auth.uid == resource.data.userId;
      
      // Rules for the items within a collection
      match /items/{itemId} {
        // The user must own the parent collection to add/remove items.
        allow read, write, create, delete: if request.auth.uid == get(/databases/$(database)/documents/collections/$(collectionId)).data.userId;
        allow update: if false;
      }
    }

    // Reviews can be read by anyone.
    // Can only be created by an authenticated user who is not the seller.
    match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth.uid != null && request.auth.uid == request.resource.data.reviewerId;
        // Users cannot update or delete reviews for now.
        allow update, delete: if false;
    }

    // Message threads can be read/updated by participants.
    match /messageThreads/{threadId} {
        allow read, update, create: if request.auth.uid in resource.data.participantIds;
        // Deletion is a soft delete via 'deletedFor' field, so handled by update.
        allow delete: if false;

        // Messages within a thread
        match /messages/{messageId} {
            allow read, create: if request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
            // No one can update or delete messages.
            allow update, delete: if false;
        }
    }

    // Any authenticated user can create a report on an item.
    match /productReports/{itemId}/reports/{userId} {
        allow create: if request.auth.uid == userId;
        allow read, update, delete: if false; // Reports are processed server-side.
    }

    // Payment intents should be created server-side, and can only be read by the user who owns it.
    match /paymentIntents/{intentId} {
        allow read: if request.auth.uid == resource.data.userId;
        allow create, update, delete: if false; // Managed by server
    }

    // Rate limits are server-only
    match /rateLimits/{limitId} {
        allow read, write: if false;
    }
  }
}
