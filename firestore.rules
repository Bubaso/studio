
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isIncrement(newData, oldData, field) {
        return newData[field] == oldData[field] + 1;
    }

    function isDecrement(newData, oldData, field) {
        return newData[field] == oldData[field] - 1;
    }

    // Rules for the 'items' collection
    match /items/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.sellerId == request.auth.uid;

      // Rules for 'views' subcollection on an item
      match /views/{viewId} {
        allow create: if isAuthenticated();
        allow read, update, delete: if false; // Views should be immutable once created
      }
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      
      // Update permissions for a user profile
      allow update: if 
        // Case 1: A user is updating their own profile details (name, avatar, location)
        (
            isOwner(userId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatarUrl', 'location', 'dataAiHint'])
        ) ||
        // Case 2: A user is updating their own subscription count (incrementing or decrementing by 1)
        (
            isOwner(userId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriptionCount']) &&
            (isIncrement(request.resource.data, resource.data, 'subscriptionCount') || isDecrement(request.resource.data, resource.data, 'subscriptionCount'))
        ) ||
        // Case 3: Another authenticated user is updating this user's subscriber count (incrementing or decrementing by 1)
        (
            isAuthenticated() && !isOwner(userId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberCount']) &&
            (isIncrement(request.resource.data, resource.data, 'subscriberCount') || isDecrement(request.resource.data, resource.data, 'subscriberCount'))
        );
        
        // Rules for user subcollections
        match /subscriptions/{targetId} {
            // A user can manage their own subscriptions list
            allow read, write, delete: if isOwner(userId);
        }

        match /subscribers/{subscriberId} {
            // A user (the subscriber) can add/remove themselves from another user's subscribers list
            allow read: if true;
            allow write, delete: if isOwner(subscriberId);
        }

        match /notifications/{notificationId} {
            // A user can read, update (e.g., mark as read), or delete their own notifications
            allow read, update, delete: if isOwner(userId);
            // Notifications are created by the server/trusted logic, not directly by other clients
            allow create: if false; 
        }

        match /viewHistory/{historyId} {
            // A user can only access their own view history.
            // History is created by server logic, not directly by client.
            allow read, write, delete: if isOwner(userId);
        }
    }

    // Rules for 'collections'
    match /collections/{collectionId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        
        match /items/{itemId} {
            allow read: if true;
            // The user must own the collection to add/remove items
            allow write, delete: if isAuthenticated() && get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == request.auth.uid;
        }
    }

    // Rules for 'messageThreads'
    match /messageThreads/{threadId} {
      allow read, update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      // Thread creation is handled by a secure API endpoint with its own logic
      allow create: if isAuthenticated(); 
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false; // Messages should be immutable
      }
    }

    // Rules for payment intents, handled server-side
    match /paymentIntents/{intentId} {
        allow read, write: if false; // No client access
    }

    // Rules for reports, handled server-side
    match /productReports/{itemId} {
        allow read, write: if false; // No direct client access
        match /reports/{userId} {
            allow read, write: if false; // No direct client access
        }
    }
    
    // Rules for rate limiting, handled server-side
    match /rateLimits/{limitId} {
        allow read, write: if false; // No client access
    }

    // Rules for reviews
    match /reviews/{reviewId} {
        allow read: if true;
        // A user must be authenticated to create a review, and they must be the author
        allow create: if isAuthenticated() && request.resource.data.reviewerId == request.auth.uid;
        // Reviews cannot be updated or deleted by clients
        allow update, delete: if false;
    }
  }
}
