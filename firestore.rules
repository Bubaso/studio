rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow public reads on users, items, and collections
    match /users/{userId} {
      allow read: if true;
      // Allow users to update their own profile and create subcollections
      allow write: if request.auth != null && request.auth.uid == userId;
      // Allow users to read their own subcollections (e.g., notifications)
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /items/{itemId} {
      allow read: if true;
      // Allow authenticated users to create items
      allow create: if request.auth != null;
      // Allow the item's seller to update or delete it
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.sellerId;

      // Allow authenticated users to log views and read view counts
      match /views/{viewId} {
        allow read, create: if request.auth != null;
      }
    }
    
    match /collections/{collectionId} {
      allow read: if true;
       // Allow authenticated users to create collections
      allow create: if request.auth != null;
      // Allow the collection's owner to update or delete it
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;

      match /items/{itemId} {
         allow read, write, delete: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/collections/$(collectionId)).data.userId;
      }
    }

    // Allow authenticated users to read/write their own reviews. Public can read all.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reviewerId;
    }

    // Allow participants to read their own threads and messages.
    // Writes are handled by server-side logic (Cloud Functions or API routes with Admin SDK)
    match /messageThreads/{threadId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participantIds;
      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
      }
    }
    
    // Allow users to submit reports if authenticated
    match /productReports/{itemId}/reports/{userId} {
        allow create: if request.auth.uid == userId;
        allow read: if true;
    }
  }
}
