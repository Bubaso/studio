
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Rules for Items
    match /items/{itemId} {
      allow read;
      allow create: if isOwner(request.resource.data.sellerId);
      allow update, delete: if isOwner(resource.data.sellerId);

      match /views/{viewId} {
        allow create: if request.auth != null && !isOwner(resource.data.sellerId);
        allow read, update, delete: if false; // No one should read/modify views directly
      }
    }

    // Rules for Reviews
    match /reviews/{reviewId} {
      allow read;
      allow create: if isOwner(request.resource.data.reviewerId);
      allow update, delete: if isOwner(request.resource.data.reviewerId) || isOwner(resource.data.sellerId);
    }
    
    // Rules for Item Reports
    match /productReports/{itemId}/reports/{userId} {
      allow write: if isOwner(userId);
      allow read: if false; // Only backend should read reports
    }

    // Rules for Favorite Collections
    match /collections/{collectionId} {
      allow read, create, update, delete: if isOwner(resource.data.userId);

      match /items/{itemId} {
        allow read, write: if isOwner(get(/databases/$(database)/documents/collections/$(collectionId)).data.userId);
      }
    }

    // Rules for Message Threads
    match /messageThreads/{threadId} {
      allow read, update: if request.auth.uid in resource.data.participantIds;
      allow create: if request.auth.uid in request.resource.data.participantIds;
      allow delete: if false; // Deletion is a flag update

      match /messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
        allow update: if request.auth.uid in resource.data.readBy; // For marking as read
      }
    }
    
    // Rules for Payment Intents
    match /paymentIntents/{intentId} {
        allow read: if isOwner(resource.data.userId);
        allow write: if false; // Only backend can write
    }

    // Rules for User Profiles and their subcollections
    match /users/{userId} {
      allow read;
      allow create: if isOwner(userId);

      function isUpdatingOwnProfile() {
        return isOwner(userId) && 
               request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['name', 'location', 'avatarUrl', 'dataAiHint', 'lastActiveAt']);
      }
      
      function isManagingOwnSubscriptions() {
        let subscriptionChange = request.resource.data.subscriptionCount - resource.data.subscriptionCount;
        return isOwner(userId) &&
               (subscriptionChange == 1 || subscriptionChange == -1) &&
               request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['subscriptionCount']);
      }
      
      function isBeingSubscribedTo() {
        let subscriberChange = request.resource.data.subscriberCount - resource.data.subscriberCount;
        return !isOwner(userId) &&
               (subscriberChange == 1 || subscriberChange == -1) &&
               request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['subscriberCount']);
      }

      allow update: if isUpdatingOwnProfile() || isManagingOwnSubscriptions() || isBeingSubscribedTo();

      // Subscriptions: Who the user {userId} is subscribed to.
      match /subscriptions/{targetId} {
        allow read, write: if isOwner(userId);
      }

      // Subscribers: Who is subscribed to user {userId}.
      match /subscribers/{subscriberId} {
        allow read, write: if isOwner(subscriberId); // A user can add/remove THEMSELVES.
      }
      
      // Notifications
      match /notifications/{notificationId} {
        allow read, update: if isOwner(userId); // User can read/update their own notifications.
        allow create, delete: if false; // Backend only.
      }

      // View History
      match /viewHistory/{historyId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
