
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow public read for items
    match /items/{itemId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth.uid == resource.data.sellerId;
    }
    
    // Allow anyone to log a view, but not read them
    match /items/{itemId}/views/{viewId} {
        allow create: if request.auth != null;
        allow read, list, update, delete: if false;
    }

    // Users can read public profiles
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
    }

    // Users can write to their own subcollections
    match /users/{userId}/subscriptions/{targetId} {
        allow read, write, delete: if request.auth.uid == userId;
    }
     match /users/{userId}/viewHistory/{historyId} {
        allow read, write, delete: if request.auth.uid == userId;
    }
    match /users/{userId}/notifications/{notificationId} {
        allow read, write, delete: if request.auth.uid == userId;
    }
    
    // Users can only read their own subscribers list. No one can write to it directly.
    match /users/{userId}/subscribers/{subscriberId} {
        allow read: if request.auth.uid == userId;
        allow write, delete: if false; // This must be managed by backend/API
    }

    // Message Threads
    match /messageThreads/{threadId} {
      allow read, update: if request.auth.uid in resource.data.participantIds;
      // create is handled by API route
      allow create: if request.auth != null; 
    }
    
    match /messageThreads/{threadId}/messages/{messageId} {
        allow read, create: if get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds[0] == request.auth.uid || get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds[1] == request.auth.uid;
        allow update, delete: if false;
    }

    // Collections
    match /collections/{collectionId} {
      allow read, write, delete: if request.auth.uid == resource.data.userId;
    }
    
    match /collections/{collectionId}/items/{itemId} {
       allow read, write, delete: if request.auth.uid == get(/databases/$(database)/documents/collections/$(collectionId)).data.userId;
    }
    
    // Reports can only be created by authenticated users
    match /productReports/{itemId}/reports/{userId} {
        allow create: if request.auth.uid == userId;
        allow read, list, update, delete: if false;
    }

    // Rate limits can only be written to by backend. Not readable by client.
    match /rateLimits/{docId} {
        allow read, write: if false;
    }

    // Counters can only be written to by backend. Not readable by client.
    match /counters/{docId} {
        allow read, write: if false;
    }

    // Payment intents can only be written to by backend. Not readable by client.
    match /paymentIntents/{docId} {
        allow read: if request.auth.uid == resource.data.userId; // Allow user to read their own payment status
        allow write: if false;
    }
  }
}
