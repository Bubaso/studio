
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // USER PROFILES
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);

      // Allow a user to update specific fields on their own document.
      // The validity of the 'status' object's content (e.g., item ownership)
      // is checked in the trusted server-side service function (updateUserStatus).
      allow update: if isOwner(userId);
      
      match /subscriptions/{targetId} {
        allow read: if true;
        allow create, delete: if isOwner(userId);
      }
      match /subscribers/{subscriberId} {
        allow read: if true;
        allow write: if false; // Only server can write here to prevent tampering
      }
      match /viewHistory/{historyId} {
        allow read, write: if isOwner(userId);
      }
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId) && request.resource.data.keys().hasOnly(['isRead']);
        // Notifications are created by a trusted server environment
        allow create: if false; 
        allow delete: if isOwner(userId);
      }
    }
    
    // COLLECTIONS (Favorites)
    match /collections/{collectionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      match /items/{itemId} {
        allow read: if isSignedIn();
        // Allow creation only by the collection owner.
        allow create: if isSignedIn() && get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == request.auth.uid;
        // Allow deletion only by the collection owner.
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == request.auth.uid;
      }
    }
    
    // ITEMS
    match /items/{itemId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.sellerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;

      match /views/{viewId} {
        allow create: if isSignedIn();
        allow read: if resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/items/$(itemId)).data.sellerId == request.auth.uid;
      }
    }
    
    // REVIEWS
    match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.reviewerId == request.auth.uid;
        allow update, delete: if false; // No updates/deletes to maintain integrity
    }

    // MESSAGE THREADS
    match /messageThreads/{threadId} {
        allow read, update: if isSignedIn() && request.auth.uid in resource.data.participantIds;
        allow create: if false; // Handled by trusted API route
        
        match /messages/{messageId} {
            allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
            allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
            allow update: if isSignedIn() && request.auth.uid == request.resource.data.senderId; // for read status
        }
    }
    
    // PRODUCT REPORTS
    match /productReports/{itemId}/reports/{userId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId);
        allow delete: if isSignedIn();
    }
    
    // SERVER-ONLY COLLECTIONS
    match /paymentIntents/{intentId} {
        allow read, write: if false;
    }
    match /rateLimits/{limitId} {
        allow read, write: if false;
    }
  }
}
