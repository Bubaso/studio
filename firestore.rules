rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Items can be read by anyone, but only created, updated, or deleted by the seller.
    match /items/{itemId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.sellerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.sellerId == request.auth.uid;

      // Anyone authenticated (except the seller) can log a view.
      match /views/{viewId} {
        allow create: if request.auth != null && get(/databases/$(database)/documents/items/$(itemId)).data.sellerId != request.auth.uid;
        allow read, update, delete: if false; // Views are write-once
      }
    }

    // User profiles can be read by anyone, but a user can only write to their own profile.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // Users can't delete their own profiles through the app

      // A user can only access their own view history.
      match /viewHistory/{historyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Message threads are private to the participants.
    match /messageThreads/{threadId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participantIds;
      
      // Messages within a thread follow the same rules.
      match /messages/{messageId} {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
      }
    }

    // Reviews can be read by anyone.
    // They can only be created by an authenticated user who is not the seller of the item.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.reviewerId == request.auth.uid
                       && request.resource.data.sellerId != request.auth.uid;
      allow update, delete: if false; // Reviews are immutable
    }

    // Users can only manage their own collections and the items within them.
    match /collections/{collectionId} {
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;

        match /items/{itemId} {
            // User must own the parent collection to interact with its items subcollection.
            // On create, also ensure the data being written has the correct userId.
            allow read, delete: if request.auth != null && get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == request.auth.uid;
            allow create: if request.auth != null 
                         && get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == request.auth.uid
                         && request.resource.data.userId == request.auth.uid;
            allow update: if false; // Items are just references, no updates needed
        }
    }

    // Payment intents are private and should be managed by the server, but client read access is needed for status checks.
    match /paymentIntents/{intentId} {
        allow read: if request.auth != null && resource.data.userId == request.auth.uid;
        allow create, update, delete: if false; // These should be done by a trusted server environment.
    }
    
    // Reports can only be created by authenticated users who are not the seller.
    match /productReports/{itemId} {
       // Allow creating the parent document implicitly via subcollection write
       allow write: if request.auth != null;
       
       match /reports/{userId} {
         allow create: if request.auth != null 
                        && request.auth.uid == userId // User can only create their own report
                        && get(/databases/$(database)/documents/items/$(itemId)).data.sellerId != request.auth.uid; // Can't report your own item
         allow read, update, delete: if request.auth != null && request.auth.uid == userId; // User can manage their own report
       }
    }
    
    // Rate limits are server-managed, no client access needed.
    match /rateLimits/{limitId} {
        allow read, write: if false;
    }
  }
}
