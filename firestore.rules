rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collections ---

    // USER PROFILES
    match /users/{userId} {
      allow read;

      // Allow a user to create their own document.
      allow create: if isOwner(userId);
        
      // Allow a user to update their own profile. 
      // The specific fields that can be updated are controlled by the application logic.
      // This rule also implicitly allows for credit/listing count decrements and subscription count changes
      // as long as they are initiated by the user on their own document.
      allow update: if isOwner(userId);

      // Allow a different authenticated user to update ONLY the subscriberCount of this user.
      allow update: if isSignedIn() &&
                      !isOwner(userId) &&
                      (request.resource.data.subscriberCount == resource.data.subscriberCount + 1 ||
                       request.resource.data.subscriberCount == resource.data.subscriberCount - 1) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberCount']);

      allow delete: if isOwner(userId);
    }

    // USER SUB-COLLECTIONS
    match /users/{userId}/{collection}/{docId} {
        // A user can read/write to their own sub-collections.
        // A subscriber can create/delete their entry in another user's 'subscribers' list.
        allow read: if isOwner(userId) || (collection == 'subscribers' && isSignedIn());
        allow create, delete: if isOwner(userId) || (collection == 'subscribers' && isOwner(docId));
        allow write: if isOwner(userId);
    }
    
    // USER COUNTER
    match /counters/userCounter {
      allow read;
      
      // This rule handles both the creation of the counter and its incrementing.
      // On create, resource is null, so (resource.data.count || 0) becomes 0.
      // The rule checks if the new count is 1, which is correct.
      // On update, it checks if the count is incremented by exactly 1.
      allow write: if isSignedIn() &&
                   request.resource.data.count == (resource.data.count || 0) + 1;
    }
    
    // ITEMS
    match /items/{itemId} {
      allow read;
      
      allow create: if isOwner(request.resource.data.sellerId);

      allow update: if isOwner(resource.data.sellerId) || 
                      (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspectedSold']));
                      
      allow delete: if isOwner(resource.data.sellerId);
      
      match /views/{viewId} {
        allow create: if isSignedIn();
        allow read, update, delete: if false;
      }
    }
    
    // COLLECTIONS (Favorites)
    match /collections/{collectionId} {
        allow read, create, update, delete: if isOwner(resource.data.userId);

        match /items/{itemId} {
            allow read: if isOwner(get(/databases/$(database)/documents/collections/$(collectionId)).data.userId);
            allow create, delete: if isOwner(get(/databases/$(database)/documents/collections/$(collectionId)).data.userId);
            allow update: if false;
        }
    }
    
    // REVIEWS
    match /reviews/{reviewId} {
      allow read;
      allow create: if isOwner(request.resource.data.reviewerId) && 
                       request.resource.data.reviewerId != request.resource.data.sellerId;
      allow update, delete: if false;
    }
    
    // MESSAGE THREADS
    match /messageThreads/{threadId} {
        function isParticipant() {
          return isSignedIn() && request.auth.uid in resource.data.participantIds;
        }
        allow read, update: if isParticipant();
        allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;

        match /messages/{messageId} {
            allow read: if get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds.hasAny([request.auth.uid]);
            allow create: if isOwner(request.resource.data.senderId);
            allow update: if get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds.hasAny([request.auth.uid]) && 
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
            allow delete: if false;
        }
    }
    
    // PRODUCT REPORTS
    match /productReports/{itemId}/reports/{userId} {
      allow read, create, delete: if isOwner(userId);
    }

    // PAYMENT INTENTS
    match /paymentIntents/{intentId} {
      allow read, create: if isOwner(request.resource.data.userId);
      allow update: if false; // Only from backend
    }
  }
}
