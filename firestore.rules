
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // --- USERS ---
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);

      // A user can update their own document under specific conditions,
      // OR another user can update this user's subscriber count.
      allow update: if isSignedIn() && (
        // Condition 1: The user is updating their OWN document.
        (isOwner(userId) && (
          // 1a: Updating general profile info
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'location', 'avatarUrl', 'dataAiHint', 'lastActiveAt']) ||
          // 1b: Paying for a listing by decrementing credits
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits']) && resource.data.credits - request.resource.data.credits == 1) ||
          // 1c: Paying for a listing by decrementing free listings
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['freeListingsRemaining']) && resource.data.freeListingsRemaining - request.resource.data.freeListingsRemaining == 1) ||
          // 1d: Updating their own subscription count when they follow/unfollow someone
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriptionCount']) && abs(resource.data.subscriptionCount - request.resource.data.subscriptionCount) == 1)
        )) ||
        // Condition 2: A DIFFERENT user is updating THIS user's subscriber count.
        (!isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberCount']) &&
          abs(resource.data.subscriberCount - request.resource.data.subscriberCount) == 1
        )
      );

      // Subcollections for Users
      match /subscriptions/{targetId} {
        allow read, write: if isOwner(userId);
      }
      match /subscribers/{subscriberId} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == subscriberId;
      }
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
      match /viewHistory/{historyId} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- ITEMS ---
    match /items/{itemId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.sellerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;

      match /views/{viewId} {
        allow create: if isSignedIn();
        allow read: if isOwner(get(/databases/$(database)/documents/items/$(itemId)).data.sellerId);
        allow write, delete: if false; // Views are immutable once created
      }
    }

    // --- REVIEWS ---
    match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.reviewerId == request.auth.uid;
        allow update, delete: if false;
    }
    
    // --- MESSAGE THREADS ---
    match /messageThreads/{threadId} {
        function isParticipant() {
            return isSignedIn() && request.auth.uid in resource.data.participantIds;
        }
        allow read, update: if isParticipant();
        allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
        
        match /messages/{messageId} {
            function isThreadParticipant() {
              return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
            }
            allow read, create: if isThreadParticipant();
            allow update: if isThreadParticipant() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        }
    }

    // --- COLLECTIONS (FAVORITES) ---
    match /collections/{collectionId} {
      function isCollectionOwner() {
        return isSignedIn() && get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == request.auth.uid;
      }
      allow read, update, delete: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);

      match /items/{itemId} {
        allow read, write, delete: if isCollectionOwner();
      }
    }

    // --- PRODUCT REPORTS ---
    match /productReports/{itemId} {
        match /reports/{userId} {
            allow create: if isOwner(userId);
            allow read, write, delete: if false;
        }
    }

    // --- PAYMENT INTENTS ---
    match /paymentIntents/{intentId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId);
    }
    
    // --- RATE LIMITS ---
    match /rateLimits/{docId} {
        allow read, write: if false; // Server-only access
    }
  }
}
