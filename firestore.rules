
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS collection
    // - Anyone can read a user's public profile.
    // - Only the authenticated user can create or update their own profile.
    // - Deletion is handled by a secure backend function.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      
      // Subcollections for user-specific data
      allow list, read: if request.auth != null && request.auth.uid == userId;
      match /subscriptions/{subscriptionId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
      match /subscribers/{subscriberId} {
        allow read: if true; // Public can see who subscribes
      }
      match /notifications/{notificationId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
      match /viewHistory/{historyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /statuses/{statusId} {
        allow read: if true;
        allow write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // COUNTERS collection (for server-side admin use only)
    match /_counters/{counterId} {
        allow read, write: if false; // No client access
    }

    // ITEMS collection
    // - Anyone can read item listings.
    // - Only authenticated users can create listings.
    // - Only the owner (seller) can update or delete their own listing.
    match /items/{itemId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
      
      // Subcollections for views
      // Allow any authenticated user to create a view document.
      // Allow any authenticated user to list the views to get a count.
      match /views/{viewId} {
        allow create: if request.auth != null;
        allow list: if request.auth != null;
      }
    }
    
    // REVIEWS collection
    // - Anyone can read reviews.
    // - Authenticated users can create reviews.
    // - Only the author of a review can update/delete it.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reviewerId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.reviewerId;
    }
    
    // COLLECTIONS collection (user's favorite lists)
    match /collections/{collectionId} {
        allow read: if request.auth != null && request.auth.uid == resource.data.userId;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
        
        // Items within a collection
        match /items/{itemId} {
            allow read, write, delete: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/collections/$(collectionId)).data.userId;
        }
    }

    // MESSAGE_THREADS collection
    match /messageThreads/{threadId} {
      // Allow a user to create a thread if they are one of the participants.
      // Allow existing participants to read or update a thread.
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantIds;
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participantIds;
      
      // MESSAGES subcollection
      // Allow a user to read or create a message if they are a participant in the parent thread.
      // This rule avoids a recursive 'get' call.
      allow read, create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
    }
    
    // PAYMENT_INTENTS collection
    // - Users can create their own payment intents.
    // - Only the user who created it can read it.
    match /paymentIntents/{intentId} {
        allow read: if request.auth != null && request.auth.uid == resource.data.userId;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // REPORTS collection
    // - Authenticated users can create reports.
    match /productReports/{itemId}/reports/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
    }

  }
}
