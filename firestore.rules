rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // --- Collections ---

    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);

      // A user can update their own profile, but NOT their own subscriberCount.
      // This prevents users from artificially inflating their own subscriber numbers.
      allow update: if isOwner(userId) &&
                      !('subscriberCount' in request.resource.data &&
                        request.resource.data.subscriberCount != resource.data.subscriberCount);
      
      // A different authenticated user can ONLY update the subscriberCount field, and only by +/- 1.
      // This is for the subscription feature.
      allow update: if isAuthenticated() && !isOwner(userId) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberCount']) &&
                      (request.resource.data.subscriberCount == resource.data.subscriberCount + 1 ||
                       request.resource.data.subscriberCount == resource.data.subscriberCount - 1);

      // Subscriptions: A user can manage their own list of who they subscribe to.
      match /subscriptions/{targetUserId} {
        allow read, write, delete: if isOwner(userId);
      }
      
      // Subscribers: The list of who subscribes to a user is managed by the subscribers themselves.
      match /subscribers/{subscriberId} {
        allow read: if true;
        allow write, delete: if isOwner(subscriberId);
      }

      // Notifications: User can only access their own notifications.
      match /notifications/{notificationId} {
          allow read, write, delete: if isOwner(userId);
      }

      // View History: User can only write to their own history.
      match /viewHistory/{historyId} {
        allow create: if isOwner(userId);
        allow read, update, delete: if false; // Users shouldn't be able to modify past history.
      }
    }
    
    // Items
    match /items/{itemId} {
      allow read: if true;
      // You must be the owner of the item to create, update or delete it.
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.sellerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.sellerId == request.auth.uid;

      // Item Views: Any authenticated user can log a view.
      match /views/{viewId} {
          allow create: if isAuthenticated();
          allow read, update, delete: if false; // No one can read/modify views directly.
      }
    }
    
    // Message Threads
    match /messageThreads/{threadId} {
        allow read, update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
        allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participantIds;
        
        // Messages within a thread
        match /messages/{messageId} {
            allow read: if isAuthenticated() && get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds.hasAny([request.auth.uid]);
            allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
            allow update, delete: if false; // Messages are immutable.
        }
    }
    
    // Reviews
    match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && 
                         request.resource.data.reviewerId == request.auth.uid &&
                         request.resource.data.reviewerId != request.resource.data.sellerId; 
        allow update, delete: if isAuthenticated() && resource.data.reviewerId == request.auth.uid;
    }
    
    // Payment Intents (Server-side only)
    match /paymentIntents/{intentId} {
        allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
        allow create, update, delete: if false; 
    }

    // Rate Limiting (Server-side only)
    match /rateLimits/{docId} {
      allow read, write, create, update, delete: if false;
    }

    // User Collections (Favorites)
    match /collections/{collectionId} {
      // User can do anything to their own collection document.
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Items within a collection
      match /items/{itemId} {
        // User can add/remove items to/from their own collections.
        allow read, write, delete: if isAuthenticated() && get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == request.auth.uid;
      }
    }
    
    // Product Reports (for suspected sold items)
    match /productReports/{itemId} {
        match /reports/{userId} {
            allow create: if isOwner(userId);
            // No one can read/update/delete reports to maintain integrity.
            allow read, update, delete: if false; 
        }
    }
  }
}
