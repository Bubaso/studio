rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // HELPER FUNCTIONS
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    // Check if a field is being incremented/decremented by 1.
    // resource.data refers to the document state *before* the operation.
    // request.resource.data refers to the document state *after* the operation.
    function isIncrement(field) {
      return request.resource.data[field] == resource.data[field] + 1;
    }
    function isDecrement(field) {
      return request.resource.data[field] == resource.data[field] - 1;
    }


    // ITEMS
    match /items/{itemId} {
      allow read: if true;
      allow create: if isSignedIn() && isOwner(request.resource.data.sellerId);
      allow update: if isSignedIn() && isOwner(resource.data.sellerId);
      allow delete: if isSignedIn() && isOwner(resource.data.sellerId);

      // Item subcollections (views)
      match /views/{viewId} {
        // Anyone signed in can create a view record. No one can read/update them directly.
        allow create: if isSignedIn();
        allow read, update, delete: if false;
      }
    }

    // USERS
    match /users/{userId} {
      allow read: if true;
      // A user can only create their own document
      allow create: if isOwner(userId);
      // A user can update their own document.
      // Another user can ONLY update the subscriberCount by +/- 1.
      allow update: if isSignedIn() &&
        (
          isOwner(userId) ||
          (
            (isIncrement('subscriberCount') || isDecrement('subscriberCount')) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subscriberCount'])
          )
        );
    }
    
    // USER SUBSCRIPTIONS
    // Path: /users/{userId}/subscriptions/{targetId}
    // {userId} is the subscriber, {targetId} is who they subscribe to.
    match /users/{userId}/subscriptions/{targetId} {
        // A user can only manage their own subscriptions.
        allow read, create, delete: if isSignedIn() && isOwner(userId);
        allow update: if false;
    }

    // USER SUBSCRIBERS
    // Path: /users/{userId}/subscribers/{subscriberId}
    // {userId} is the person being subscribed to, {subscriberId} is the one subscribing.
    match /users/{userId}/subscribers/{subscriberId} {
        // A user can add/remove themselves from someone else's subscriber list.
        allow create, delete: if isSignedIn() && isOwner(subscriberId);
        // No one can read who subscribes to a user or update the entry.
        allow read, update: if false;
    }
    
    // USER NOTIFICATIONS & VIEW HISTORY
    match /users/{userId}/{subcollection}/{docId}
      where subcollection in ['notifications', 'viewHistory'] {
        // A user can only access their own notifications and view history.
        allow read, write, delete: if isSignedIn() && isOwner(userId);
    }

    // COLLECTIONS (Favorites)
    match /collections/{collectionId} {
        allow read: if isSignedIn() && isOwner(resource.data.userId);
        allow create: if isSignedIn() && isOwner(request.resource.data.userId);
        allow update, delete: if isSignedIn() && isOwner(resource.data.userId);
    }

    match /collections/{collectionId}/items/{itemId} {
        allow read, write, delete: if isSignedIn() &&
            isOwner(get(/databases/$(database)/documents/collections/$(collectionId)).data.userId);
    }
    
    // MESSAGE THREADS
    match /messageThreads/{threadId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
    }

    // MESSAGES SUBCOLLECTION
    match /messageThreads/{threadId}/messages/{messageId} {
      // Participants can read/write messages
      allow read, create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
      // Messages are immutable once created
      allow update, delete: if false;
    }
    
    // PAYMENT INTENTS
    match /paymentIntents/{intentId} {
      // Only the owner can read their payment intent.
      allow read: if isSignedIn() && isOwner(resource.data.userId);
      // Only a signed-in user can create an intent for themselves.
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      // No one can update/delete intents from the client. This is handled by server-side IPN.
      allow update, delete: if false;
    }
    
    // REVIEWS
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isOwner(request.resource.data.reviewerId);
      allow update, delete: if false; // Reviews are immutable.
    }
    
    // PRODUCT REPORTS
    match /productReports/{itemId}/reports/{userId} {
        // Any signed-in user can report an item once.
        allow create: if isSignedIn() && isOwner(userId);
        // No one can read/update/delete individual reports.
        allow read, update, delete: if false;
    }
  }
}
