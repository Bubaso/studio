
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Items can be read by anyone, but only created/updated/deleted by the seller.
    match /items/{itemId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.resource.data.sellerId == request.auth.uid;

      // Views and other subcollections can be written to by any authenticated user
      match /views/{viewId} {
        allow create: if request.auth != null;
        allow read, update, delete: if false;
      }
    }

    // User profiles can be read by anyone, but only created/updated by the owner.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      // Disallow client-side deletion of user profiles for safety. Should be a secure API call.
      allow delete: if false;

      // User-specific subcollections (favorites, notifications, etc.)
      match /subscriptions/{subscriptionId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
      match /subscribers/{subscriberId} {
        allow read, write, delete: if request.auth != null; // Managed by API
      }
      match /notifications/{notificationId} {
         allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
       match /viewHistory/{historyId} {
         allow write: if request.auth != null && request.auth.uid == userId;
         allow read, update, delete: if false;
      }
    }

    // Message threads: only participants can read/write
    match /messageThreads/{threadId} {
      allow read, update, create: if request.auth != null && request.auth.uid in resource.data.participantIds;
      // Deletion is a "soft delete" (update a flag), so no direct delete
      allow delete: if false;

      match /messages/{messageId} {
        allow read, create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
        allow update, delete: if false; // Messages should be immutable
      }
    }

    // Reviews can be created by any authenticated user, but not modified.
    match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.reviewerId;
        allow update, delete: if false;
    }
    
    // Product reports: allow creation by any auth'd user
    match /productReports/{itemId}/reports/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if false;
    }

    // Collections
    match /collections/{collectionId} {
        allow read: if true; // Public collections can be interesting
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;

        // Items within a collection
        match /items/{itemId} {
          allow read, write, delete: if request.auth != null && get(/databases/$(database)/documents/collections/$(collectionId)).data.userId == request.auth.uid;
        }
    }
    
    // Payment intents are private and can only be accessed by the user who created them
    match /paymentIntents/{intentId} {
      allow read, write: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Rate limits are only written by the server, not accessible by clients.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }
  }
}
