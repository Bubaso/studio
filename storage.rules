
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read access for promotional media (modals, etc.)
    match /motion-gallery/{allPaths=**} {
      allow read: if true;
    }
    
    // Allow users to read all item images and avatars
    match /itemImages/{allPaths=**} {
      allow read: if true;
    }
    match /avatars/{allPaths=**} {
      allow read: if true;
    }

    // Allow authenticated users to write to their own media folders
    match /itemImages/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /itemVideos/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /avatars/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for chat attachments can be added here if needed
  }
}
